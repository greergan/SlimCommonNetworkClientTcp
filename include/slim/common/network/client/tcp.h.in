#ifndef SLIM_COMMON_NETWORK_CLIENT_TCP_H
#define SLIM_COMMON_NETWORK_CLIENT_TCP_H
#include <netdb.h>
#include <sys/socket.h>
#include <netinet/in.h>
#ifdef SLIM_TLS_ENABLED
#include <mutex>
#include <openssl/ssl.h>
#include <openssl/err.h>
#endif
#include <cstdint>
#include <string_view>
#include <vector>
#include <slim/common/network/error_codes.h>
#define SLIMCOMMONNETWORKCLIENTTCP_VERSION "@SLIMCOMMONNETWORKCLIENTTCP_VERSION@"
#define SLIMCOMMONNETWORKCLIENTTCP_GIT_HASH "@SLIMCOMMONNETWORKCLIENTTCP_GIT_HASH@"
namespace slim::common::network::client::tcp {
    constexpr size_t BUFFER_SIZE = 1024;
    class Connection {
        public:
            Connection() = delete;
            Connection(std::string_view host, const uint16_t port, const bool is_tls = false, const int timeout_ms = 5000);
#ifdef SLIM_TLS_ENABLED
            Connection(std::string_view host, const uint16_t port, SSL_CTX* ssl_ctx, const int timeout_ms = 5000);
#endif
            ~Connection();
            network::ErrorStatus read(std::vector<uint8_t>& buf, const int timeout_ms = 5000);
            network::ErrorStatus write(std::string_view payload, std::vector<uint8_t>& buf, const int timeout_ms = 5000);
        private:
            int socket_handle_                  = 0;
            struct sockaddr_in server_address_;
            struct addrinfo* addrinfo_          = nullptr;
            bool is_tls_                        = false;
#ifdef SLIM_TLS_ENABLED
            SSL_CTX* ssl_ctx_                   = nullptr;
            SSL*     ssl_                       = nullptr;
            bool     owns_ssl_ctx_              = false;
            void init_tls(std::string_view host, const int timeout_ms);
            static std::once_flag ssl_init_flag_;
#endif
            void init_socket(std::string_view host, const uint16_t port, const int timeout_ms);
    };
}
#endif // SLIM_COMMON_NETWORK_CLIENT_TCP_H
